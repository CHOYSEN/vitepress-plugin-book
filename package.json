{
  "name": "vitepress-plugin-book",
  "version": "0.1.0",
  "description": "VitePress plugin to enhance reading experience for open-source books — progress tracking, scroll memory, reading stats, and more.",
  "keywords": [
    "documentation",
    "ebook",
    "reader",
    "reading-progress",
    "vitepress",
    "vitepress-plugin"
  ],
  "license": "MIT",
  "author": "",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/client/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/style.css": "./dist/client/style.css"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-post.mjs",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build",
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc",
    "postinstall": "simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.12.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "unplugin-vue": "^7.2.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vitepress": ">=1.0.0",
    "vue": ">=3.3.0"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged",
    "commit-msg": "./node_modules/.bin/commitlint --edit",
    "pre-push": "pnpm run typecheck"
  },
  "nano-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "**/src/**/*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
